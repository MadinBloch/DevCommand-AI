NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devcommand_ai
SESSION_SECRET=replace-with-a-long-random-secret
# Optional dedicated key for encrypting stored API/GitHub tokens (recommended)
SECRETS_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
APP_ORIGIN=http://localhost:5173

# manual | simulate
# - manual: real agents / LLM coder / CLIs
# - simulate: demo-only commits under .devcommand/ (never shown as connected coding agents)
AGENT_MODE=manual
SUPERVISOR_INTERVAL_MS=8000
WORKER_CONCURRENCY=2
MAX_PARALLEL_SUBTASKS=3
AGENT_JOB_TIMEOUT_SEC=1800
AGENT_CLI_TIMEOUT_MS=900000
VERIFY_TIMEOUT_MS=600000
PGBOSS_SCHEMA=pgboss

# Isolated workspaces (default: local git worktrees)
WORKSPACE_ROOT=
# Set to 1 to run agents inside Docker containers instead of host worktrees
DOCKER_WORKER=0
DOCKER_WORKER_IMAGE=node:20-bookworm

# Built-in LLM planner + patch coder (NOT the same as Codex / Claude Code CLIs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=

# Only if you want Codex subtasks to fall back to LLM patches when CLI missing (labels result as llm-fallback)
CODEX_LLM_FALLBACK=0
# Allow creating runs when only CLIs are expected (auto-detected via /api/agents)
ALLOW_CLI_AGENTS=1

# Optional HTTP adapters (trusted services only — GitHub token forwarded only if ADAPTER_FORWARD_GITHUB_TOKEN=1)
ADAPTER_FORWARD_GITHUB_TOKEN=0
ANTIGRAVITY_API_URL=
ANTIGRAVITY_API_KEY=
CODEX_API_URL=
CODEX_API_KEY=

# Merge policy
ALLOW_MERGE_PENDING_CI=0
DEPLOY_BASE_URL=
