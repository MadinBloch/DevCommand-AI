NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devcommand_ai
SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
APP_ORIGIN=http://localhost:5173

# manual | simulate — simulate advances agents without external APIs
AGENT_MODE=simulate
SUPERVISOR_INTERVAL_MS=8000

# Optional LLM planner
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional real agent adapters
ANTIGRAVITY_API_URL=
ANTIGRAVITY_API_KEY=
CODEX_API_URL=
CODEX_API_KEY=
DEPLOY_BASE_URL=
