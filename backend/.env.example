NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devcommand_ai
SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
APP_ORIGIN=http://localhost:5173

# manual | simulate
# - manual (recommended): requires user OpenAI key in Settings (or server OPENAI_API_KEY)
# - simulate: demo-only commits under .devcommand/ (confusing — avoid unless testing PR flow)
AGENT_MODE=manual
SUPERVISOR_INTERVAL_MS=8000

# Built-in LLM planner + coder (recommended for real file changes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional external agent adapters (preferred when available)
ANTIGRAVITY_API_URL=
ANTIGRAVITY_API_KEY=
CODEX_API_URL=
CODEX_API_KEY=
DEPLOY_BASE_URL=
